#!/bin/sh

# 禁用 uhttpd, 使用 nginx 作为 Web 服务器
/etc/init.d/uhttpd disable 2>/dev/null
/etc/init.d/uhttpd stop 2>/dev/null

# 移除 restrict_locally IP 白名单限制 (允许 WAN 口访问 LuCI)
# restrict_locally 默认 deny all, 仅允许内网网段, 会导致 WAN IPv6 返回 403
uci -q del_list nginx._lan.include='restrict_locally'

# 确保 _lan server 同时监听 80 (HTTP) 和 443 (HTTPS, IPv4+IPv6)
# 必须显式配置 [::]:80, 否则 nginx 默认不监听 IPv6 的 80 端口, 导致纯 IPv6 域名 HTTP 访问失败
# 使用 delete + add_list 避免重复追加 (uci set 会覆盖, add_list 会追加, 混用会重复)
uci -q delete nginx._lan.listen
uci add_list nginx._lan.listen='80'
uci add_list nginx._lan.listen='[::]:80'
uci add_list nginx._lan.listen='443 ssl default_server'
uci add_list nginx._lan.listen='[::]:443 ssl default_server'
uci commit nginx

# 创建 nginx.conf 符号链接指向 uci.conf (init 脚本每次启动时生成)
# 缺失此链接会导致 nginx -t 报 "open() nginx.conf failed"
mkdir -p /var/lib/nginx
ln -sf /var/lib/nginx/uci.conf /etc/nginx/nginx.conf

# 启用并启动 nginx
/etc/init.d/nginx enable 2>/dev/null
/etc/init.d/nginx restart 2>/dev/null

exit 0
