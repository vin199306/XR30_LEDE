#!/bin/sh

# 扩大 /tmp tmpfs 到 400M (默认约为内存一半,约 240M)
# uci-defaults 只在首次启动运行一次, 这里把 remount 命令写入 rc.local
# rc.local 每次启动都会执行, 确保重启后 /tmp 仍为 400M

RC_LOCAL=/etc/rc.local

# 确保 rc.local 存在且可执行
touch "$RC_LOCAL"
chmod +x "$RC_LOCAL"

# 避免重复添加
grep -q "remount,size=400M /tmp" "$RC_LOCAL" || {
    # 在 exit 0 之前插入 remount 命令
    # 如果文件已有 exit 0, 在其前面插入; 否则追加
    if grep -q "^exit 0" "$RC_LOCAL"; then
        sed -i '/^exit 0/i\mount -o remount,size=400M /tmp' "$RC_LOCAL"
    else
        echo 'mount -o remount,size=400M /tmp' >> "$RC_LOCAL"
        echo 'exit 0' >> "$RC_LOCAL"
    fi
}

# 立即执行一次
mount -o remount,size=400M /tmp

exit 0
